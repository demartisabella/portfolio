---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PAGES } from "../../config";

if (PAGES.cv.isActive === false) {
    return Astro.redirect("/404");
}

const BASE = import.meta.env.BASE_URL;
---

<BaseLayout title={PAGES.cv.title}>
    <header class="page-header">
        <h1 class="page-title">{PAGES.cv.title}</h1>
        <p class="page-subtitle">
            A concise overview of my academic background, research, engineering
            projects, leadership experience, and technical skills.
        </p>
    </header>

    <div class="container-narrow">

        <div class="cv-container">

            <img
                src={`${BASE}cv/Isabella_DeMarti_CV_Preview.jpg`}
                alt="Curriculum Vitae Preview"
                class="cv-preview"
            />

            <div class="cv-actions">

                <a
                    href={`${BASE}cv/Isabella_DeMarti_CV.pdf`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cv-button primary"
                >
                    View CV →
                </a>

                <a
                    href={`${BASE}cv/Isabella_DeMarti_CV.pdf`}
                    download
                    class="cv-button secondary"
                >
                    Download PDF
                </a>

            </div>

        </div>

    </div>
<p class="cv-note">
Last updated: June 2026 · References available upon request.
</p>
</BaseLayout>

<style>
.cv-note{
    text-align:left;
    margin-top:2rem;
    opacity:.65;
    font-size:.9rem;
}
.cv-container{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:2rem;
}

.cv-preview{
    width:100%;
    max-width:760px;

    border-radius:18px;

    border:1px solid var(--border);

    box-shadow:
        0 12px 30px rgba(0,0,0,.08);

    transition:
        transform .35s ease,
        box-shadow .35s ease;
}

.cv-actions{

    display:flex;
    gap:1rem;

    flex-wrap:wrap;

    justify-content:center;
}

.cv-button{

    padding:.85rem 1.6rem;

    border-radius:999px;

    font-weight:600;

    transition:.25s;

    text-decoration:none;
}

.cv-button.primary{

    background:var(--accent);

    color:white;
}

.cv-button.primary:hover{

    opacity:.9;

    transform:translateY(-2px);
}

.cv-button.secondary{

    border:1px solid var(--border);

    color:var(--text);

    background:var(--background);
}

.cv-button.secondary:hover{

    background:var(--surface);

    transform:translateY(-2px);
}

</style>