---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PAGES } from "../config";
import { getCollection } from "astro:content";

// Load bio content
const research = await getCollection("research");
const engineering = await getCollection("engineering");
const bioEntry = await getEntry("bio", "bio");
const { Content: BioContent } = bioEntry
	? await render(bioEntry)
	: { Content: null };
---

<BaseLayout title="Home">

<section class="hero">

    <div class="hero-status">
        • CURRENTLY IN EIGHTH SEMESTER AT TECNOLÓGICO DE COSTA RICA —
        OPEN TO NEW OPPORTUNITIES
    </div>

    <div class="hero-grid">

        <div class="hero-left">

            <h1 class="hero-title">
                <span>Process.</span>
                <span>Automation.</span>
                <span class="accent">Impact.</span>
            </h1>

            <p class="hero-description">
                Bridging traditional continuous improvement (Lean/DMAIC) with Industry 4.0 automation 
                (Power Platform, Power BI) to deliver measurable operational results.
            </p>

        	<a href="mailto:demartisabella@gmail.com" class="hero-contact">
    			Get in touch →
			</a>

        </div>

        <div class="hero-right">

			<img
    			src="/images/LogoName.png"
    			alt="Logo"
    			class="logo-light"
			/>

			<img
    			src="/images/LogoNameDark.png"
    			alt="Logo"
    			class="logo-dark"
			/>


        </div>

    </div>

    <div class="hero-stats">

    <a href="/engineering/montik" class="stat-card">
        <h2>1</h2>
        <p>
			International Award
			<span class="stat-arrow">→</span>
		</p>
    </a>

    <a href="/engineering" class="stat-card">
        <h2>{engineering.length}</h2>
        <p>
			Industry Projects
			<span class="stat-arrow">→</span>
		</p>
    </a>

    <a href="/research" class="stat-card">
        <h2>{research.length}</h2>
        <p>
			Research Papers
			<span class="stat-arrow">→</span>
		</p>
    </a>

</div>

</section>

</BaseLayout>
