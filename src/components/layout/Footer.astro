---
import { SITE, THEME_CONFIG, SETTINGS, SOCIALS, SOCIAL_ICONS } from "../../config";
import Icon from "../ui/Icon.astro";
import { getCollection } from "astro:content";
const currentYear = new Date().getFullYear();
const showToggle = THEME_CONFIG.lightAndDark;
const showDevTools = import.meta.env.DEV || SETTINGS.addDevToolsInProduction;
const activeSocials = SOCIALS.filter((s) => s.isActive);
const bioCollection = await getCollection("bio");
const bio = bioCollection[0]?.data;
const BASE = import.meta.env.BASE_URL;
---

<footer class="footer">

    <!-- Left Side -->
    <div class="flex flex-col gap-2">
        {bio?.name && <h2 class="sidebar-name">{bio.name}</h2>}
        {bio?.institution && <body class="sidebar-name">{bio.institution}</body>}

        <div class="flex gap-2 mt-2">
            {activeSocials.map((social) => (
                <a
                    href={social.href}
                    aria-label={social.linkTitle}
                    title={social.linkTitle}
                    target="_blank"
                    rel="noreferrer"
                    class="social-link"
                >
                    <Icon
                        name={SOCIAL_ICONS[social.name] || social.name}
                        size={16}
                    />
                </a>
            ))}
        </div>
    </div>

    <!-- Right Side -->
    <div class="flex flex-col items-end mt-auto">

        <div class="flex gap-2">

            {showToggle && (
                <button
                    id="theme-toggle"
                    aria-label="Toggle Dark Mode"
                    class="btn-icon"
                >
                    <Icon name="Sun" size={16} class="hidden dark:block" />
                    <Icon name="Moon" size={16} class="block dark:hidden" />
                </button>
            )}

            {showDevTools && (
                <a
                    href={`${BASE}dev-tools`}
                    aria-label="Developer Tools"
                    class="btn-icon"
                >
                    <Icon name="Settings" size={16} />
                </a>
            )}

        </div>
        


    </div>

</footer>