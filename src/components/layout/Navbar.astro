---
import { NAV_LINKS, PAGES } from "../../config";

const currentPath = Astro.url.pathname;
const BASE = import.meta.env.BASE_URL;
---

<nav class="navbar">
    <ul class="nav-links">
            {
    NAV_LINKS.filter(...).map((link) => {

        const href =
            link.href === "/"
                ? BASE
                : `${BASE}${link.href.slice(1)}`;

        return (
            <li>

                <a
                    href={href}
                    class={`nav-link ${
                        currentPath === href ||
                        (link.href !== "/" &&
                        currentPath.startsWith(href))
                            ? "active"
                            : "inactive"
                    }`}
                >

                    {link.label}

                    <span class="nav-link-line" />

                </a>

            </li>
        );
    })
    }
    </ul>
</nav>
