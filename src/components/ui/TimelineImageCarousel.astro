---
interface Props {
    images: string[];
    alt: string;
}

const { images, alt } = Astro.props;

const carouselId = `carousel-${Math.random().toString(36).slice(2, 9)}`;
---

<div
    class="timeline-carousel"
    id={carouselId}
>

    {
        images.map((image, index) => (
            <img
                src={image}
                alt={alt}
                class:list={[
                    "timeline-image",
                    index === 0 && "active"
                ]}
            />
        ))
    }

    {
        images.length > 1 && (
            <button
                class="timeline-next"
                aria-label="Next image"
            >
                →
            </button>
        )
    }

</div>

<script is:inline>

document.querySelectorAll(".timeline-carousel").forEach((carousel)=>{

    const images = carousel.querySelectorAll(".timeline-image");

    const button = carousel.querySelector(".timeline-next");

    if(!button || images.length<=1) return;

    let current = 0;

    button.addEventListener("click",(e)=>{

        e.preventDefault();

        images[current].classList.remove("active");

        current++;

        if(current>=images.length){

            current=0;

        }

        images[current].classList.add("active");

    });

});

</script>