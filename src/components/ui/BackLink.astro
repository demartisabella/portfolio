---
interface Props {
    href: string;
    label: string;
}

const { href, label } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const backHref =
    href.startsWith("/")
        ? `${BASE}${href}`
        : href;
---

<a href={backHref} class="back-link">
    Go back to {label}
</a>